# ─────────────────────────────────────────────────────────────────────────────
# personal-health-mcp configuration
#
# Copy to `.env` and fill in. Generate secrets with the commands shown.
# NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Public HTTPS origin this server is reachable at (no trailing slash).
# Used to build OAuth redirect URIs: <PUBLIC_BASE_URL>/oauth/<provider>/callback
PUBLIC_BASE_URL=https://health.example.com

# ── MCP endpoint authentication ──────────────────────────────────────────────
# Default: static bearer token MCP clients must send as `Authorization: Bearer <token>`.
# REQUIRED unless GitHub OAuth (below) is configured — the server refuses to start
# with both unset rather than serve an open /mcp endpoint.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_AUTH_TOKEN=

# OPTIONAL: protect /mcp with GitHub OAuth instead of the bearer token. When both
# id+secret are set, clients (Claude Desktop, mcp-remote) do a browser login.
# Create a GitHub OAuth app (Settings > Developer settings > OAuth Apps) with
# Authorization callback URL:  <PUBLIC_BASE_URL>/auth/callback
# GITHUB_ALLOWED_USERS (comma-separated logins) is REQUIRED when OAuth is enabled:
# the server refuses to start with an empty allowlist, since any GitHub account
# could otherwise reach your health data.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERS=

# Single-user web UI password (used to derive an argon2id hash at boot).
WEB_PASSWORD=

# Secret key signing session cookies. REQUIRED — the server refuses to start if
# blank (an unset value would sign cookies with a public default = forgeable logins).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Fernet key encrypting OAuth tokens & client secrets at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Supports rotation: comma-separate keys, newest first (MultiFernet).
TOKEN_ENC_KEY=

# SQLite database path (inside the container this is on the mounted volume).
DATABASE_PATH=/data/health.db

# Logging level: debug | info | warning | error
LOG_LEVEL=info

# ── Provider API credentials (OPTIONAL) ──────────────────────────────────────
# Normally entered via the web UI (/providers) and stored encrypted in the DB.
# These env vars are only a headless/bootstrap fallback. Leave blank to use UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# ── Cloudflare Tunnel overlay (deploy/compose.cloudflared.yml) ────────────────
# Token from `cloudflared tunnel token <NAME>` or the Zero Trust dashboard.
CF_TUNNEL_TOKEN=

# ── Caddy overlay (deploy/compose.caddy.yml) ─────────────────────────────────
# Bare domain Caddy serves + obtains a Let's Encrypt cert for.
CADDY_DOMAIN=health.example.com
